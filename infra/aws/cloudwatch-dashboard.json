      "properties": {
        "title": "W7 - Trafico frontend -> backends (Service Connect)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "RequestCountPerTarget", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "label": "frontend -> backend1" }],
          ["AWS/ECS", "RequestCountPerTarget", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "label": "frontend -> backend2" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W8 - Conexiones activas y nuevas (backend1 y backend2)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "ActiveConnectionCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend1", "ServiceName", "backend1", { "stat": "Average", "label": "backend1 Active (Avg)" }],
          ["AWS/ECS", "NewConnectionCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend1", "ServiceName", "backend1", { "stat": "Sum", "label": "backend1 New (Sum)" }],
          ["AWS/ECS", "ActiveConnectionCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend2", "ServiceName", "backend2", { "stat": "Average", "label": "backend2 Active (Avg)" }],
          ["AWS/ECS", "NewConnectionCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend2", "ServiceName", "backend2", { "stat": "Sum", "label": "backend2 New (Sum)" }]
