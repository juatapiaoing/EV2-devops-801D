{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 3,
      "properties": {
        "markdown": "# DOY0101 — Orquestacion y Observabilidad de Microservicios en AWS\n**Evaluacion Parcial N°3 / Actividad 3.2** | **Autor:** Juan Carlos Tapia | **Arquitectura 100% AWS:** Amazon ECR (imagenes versionadas `1.0.0`) + Amazon ECS Fargate (`doy0101-ecs`) + ECS Service Connect (`microservices-demo`) + Amazon CloudWatch (Container Insights, Service Connect, Logs, Alarmas y Metricas CI/CD)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W1 - CPU y Memoria (Container Insights)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 60,
        "metrics": [
          ["ECS/ContainerInsights", "CpuUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "label": "frontend CPU" }],
          ["ECS/ContainerInsights", "CpuUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "label": "backend1 CPU" }],
          ["ECS/ContainerInsights", "CpuUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "label": "backend2 CPU" }],
          ["ECS/ContainerInsights", "MemoryUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "yAxis": "right", "label": "frontend Mem (MiB)" }],
          ["ECS/ContainerInsights", "MemoryUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "yAxis": "right", "label": "backend1 Mem (MiB)" }],
          ["ECS/ContainerInsights", "MemoryUtilized", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "yAxis": "right", "label": "backend2 Mem (MiB)" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 3,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W2 - Disponibilidad: Tareas Running vs Desired",
        "view": "singleValue",
        "region": "us-east-1",
        "stat": "Minimum",
        "period": 60,
        "metrics": [
          ["ECS/ContainerInsights", "RunningTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "label": "frontend Running" }],
          ["ECS/ContainerInsights", "DesiredTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "label": "frontend Desired" }],
          ["ECS/ContainerInsights", "RunningTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "label": "backend1 Running" }],
          ["ECS/ContainerInsights", "DesiredTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "label": "backend1 Desired" }],
          ["ECS/ContainerInsights", "RunningTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "label": "backend2 Running" }],
          ["ECS/ContainerInsights", "DesiredTaskCount", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "label": "backend2 Desired" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W3 - Trafico de Red Rx / Tx (Container Insights)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 60,
        "metrics": [
          ["ECS/ContainerInsights", "NetworkRxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "label": "frontend Rx" }],
          ["ECS/ContainerInsights", "NetworkTxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", { "label": "frontend Tx" }],
          ["ECS/ContainerInsights", "NetworkRxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "label": "backend1 Rx" }],
          ["ECS/ContainerInsights", "NetworkTxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "backend1", { "label": "backend1 Tx" }],
          ["ECS/ContainerInsights", "NetworkRxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "label": "backend2 Rx" }],
          ["ECS/ContainerInsights", "NetworkTxBytes", "ClusterName", "doy0101-ecs", "ServiceName", "backend2", { "label": "backend2 Tx" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 9,
      "width": 12,
      "height": 6,
      "properties": {
