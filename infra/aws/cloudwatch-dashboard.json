        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "RequestCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend1", "ServiceName", "backend1", { "label": "backend1 RequestCount" }],
          ["AWS/ECS", "RequestCount", "ClusterName", "doy0101-ecs", "DiscoveryName", "backend2", "ServiceName", "backend2", { "label": "backend2 RequestCount" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W5 - Latencia TargetResponseTime (Promedio y p99)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "TargetResponseTime", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "stat": "Average", "label": "backend1 Avg (ms)" }],
          ["AWS/ECS", "TargetResponseTime", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "stat": "p99", "label": "backend1 p99 (ms)" }],
          ["AWS/ECS", "TargetResponseTime", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "stat": "Average", "label": "backend2 Avg (ms)" }],
          ["AWS/ECS", "TargetResponseTime", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "stat": "p99", "label": "backend2 p99 (ms)" }]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 15,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "W6 - Codigos HTTP 2XX / 4XX / 5XX (Apilado)",
        "view": "timeSeries",
        "stacked": true,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "HTTPCode_Target_2XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "color": "#2ca02c", "label": "backend1 2XX" }],
          ["AWS/ECS", "HTTPCode_Target_2XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "color": "#98df8a", "label": "backend2 2XX" }],
          ["AWS/ECS", "HTTPCode_Target_4XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "color": "#ff7f0e", "label": "backend1 4XX" }],
          ["AWS/ECS", "HTTPCode_Target_4XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "color": "#ffbb78", "label": "backend2 4XX" }],
          ["AWS/ECS", "HTTPCode_Target_5XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend1", { "color": "#d62728", "label": "backend1 5XX" }],
          ["AWS/ECS", "HTTPCode_Target_5XX_Count", "ClusterName", "doy0101-ecs", "ServiceName", "frontend", "TargetDiscoveryName", "backend2", { "color": "#ff9896", "label": "backend2 5XX" }]
        ]
      }
    },
