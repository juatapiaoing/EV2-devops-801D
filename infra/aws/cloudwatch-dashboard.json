          ["DOY0101/CICD", "CoberturaLineasPct", "Proyecto", "doy0101-microservicios", { "stat": "Maximum", "label": "Cobertura Lineas (%)" }],
          ["DOY0101/CICD", "CoberturaRamasPct", "Proyecto", "doy0101-microservicios", { "stat": "Maximum", "label": "Cobertura Ramas (%)" }],
          ["DOY0101/CICD", "PruebasFallidas", "Proyecto", "doy0101-microservicios", { "stat": "Sum", "label": "Pruebas Fallidas" }],
          ["DOY0101/CICD", "ErroresDespliegue", "Proyecto", "doy0101-microservicios", { "stat": "Sum", "label": "Errores Despliegue" }]
