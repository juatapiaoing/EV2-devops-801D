    {
      "type": "log",
      "x": 0,
      "y": 33,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "W11 - CloudWatch Logs Insights (/ecs/frontend, /ecs/backend1, /ecs/backend2)",
        "region": "us-east-1",
        "query": "SOURCE '/ecs/frontend' | SOURCE '/ecs/backend1' | SOURCE '/ecs/backend2' | fields @timestamp, @logStream, @message | sort @timestamp desc | limit 30",
