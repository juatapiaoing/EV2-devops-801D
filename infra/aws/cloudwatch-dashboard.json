        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 60,
        "metrics": [
          ["DOY0101/AppLogs", "Frontend404Count", { "color": "#ff7f0e", "label": "Frontend 404" }],
          ["DOY0101/AppLogs", "BackendErrorCount", { "color": "#d62728", "label": "Backends ERROR/500" }]
